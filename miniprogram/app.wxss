page {
  min-height: 100%;
  background: #fff9f8;
  color: #3b2d2f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section-title {
  margin: 28rpx 0 18rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.card {
  border: 1rpx solid #f4d8dd;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(221, 112, 141, 0.08);
  padding: 28rpx;
}

.primary-button {
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff789d, #ff4f7d);
  color: #ffffff;
  font-weight: 600;
}

.secondary-button {
  border: 1rpx solid #f3d9df;
  border-radius: 999rpx;
  background: #fff5f7;
  color: #a45c70;
}

button::after {
  border: none;
}

image {
  display: block;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
}

.empty-subtitle {
  color: #8c7f7a;
  font-size: 25rpx;
  line-height: 1.55;
}
