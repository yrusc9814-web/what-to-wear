page { min-height: 100%; background: #fffaf9; color: #433d40; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button { margin: 0; padding: 0; line-height: 1; font-size: inherit; background: transparent; }
button::after { border: 0; }
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx calc(42rpx + env(safe-area-inset-bottom)); }
.steps { display: flex; align-items: center; justify-content: center; margin: 10rpx 0 34rpx; }
.step { display: flex; align-items: center; gap: 8rpx; color: #aaa0a4; font-size: 23rpx; white-space: nowrap; }
.step-number { width: 38rpx; height: 38rpx; border-radius: 50%; background: #fcecef; display: flex; align-items: center; justify-content: center; color: #eda0b3; }
.step.active { color: #ec5e82; font-weight: 600; }
.step.active .step-number { color: #fff; background: #ef6386; }
.step-line { width: 46rpx; height: 2rpx; margin: 0 8rpx; background: #efdcdf; }
.active-line { background: #ed829d; }
.upload-panel { min-height: 500rpx; border: 2rpx dashed #f2b9c6; border-radius: 30rpx; background: #fffdfd; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36rpx; box-sizing: border-box; }
.hanger-icon { font-size: 76rpx; color: #f193aa; }
.upload-title { margin-top: 24rpx; font-size: 30rpx; font-weight: 600; }
.upload-help { margin-top: 18rpx; color: #9a8f94; font-size: 22rpx; line-height: 1.7; text-align: center; }
.upload-actions { display: flex; gap: 20rpx; margin-top: 54rpx; }
.primary, .soft, .mini-button, .text-button { display: flex; align-items: center; justify-content: center; border-radius: 38rpx; }
.primary { color: #fff; background: linear-gradient(135deg, #f77b99, #ef567c); box-shadow: 0 12rpx 24rpx rgba(235, 78, 117, .15); }
.soft { color: #df637e; background: #fff0f3; border: 2rpx solid #f5cbd5; }
.small-button { min-width: 190rpx; height: 72rpx; padding: 0 26rpx; font-size: 25rpx; }
.upload-preview { width: 100%; height: 310rpx; }
.upload-preview image { width: 100%; height: 100%; }
.tip-card, .form-card, .recognition-card, .confirm-banner { margin-top: 26rpx; padding: 28rpx; border: 2rpx solid #f2e2df; border-radius: 28rpx; background: rgba(255,255,255,.84); box-shadow: 0 12rpx 30rpx rgba(181, 119, 127, .05); }
.section-title { display: block; color: #453e41; font-size: 28rpx; font-weight: 650; }
.section-copy, .safe-note { display: block; margin-top: 14rpx; color: #968b90; font-size: 22rpx; line-height: 1.65; }
.safe-note { padding: 16rpx 20rpx; background: #fff5f6; border-radius: 16rpx; color: #a17f87; }
.tips { display: flex; flex-direction: column; gap: 17rpx; margin-top: 26rpx; color: #746a6e; font-size: 23rpx; }
.tips text::first-letter { color: #f06286; }
.recognition-card { display: flex; gap: 24rpx; align-items: center; }
.recognition-image { flex: 0 0 250rpx; width: 250rpx; height: 230rpx; border-radius: 22rpx; background: #fff8f8; }
.recognition-status { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
.status-title { color: #645b5f; font-size: 26rpx; font-weight: 600; }
.status-title.success { color: #69a559; }
.status-title.warning { color: #d58a56; }
.status-copy { margin-top: 14rpx; color: #94898e; font-size: 22rpx; line-height: 1.6; }
.mini-button { min-width: 150rpx; height: 58rpx; margin-top: 18rpx; padding: 0 22rpx; border: 2rpx solid #f3c5d0; color: #e75e80; background: #fff2f4; font-size: 22rpx; }
.text-button { height: 54rpx; margin-top: 8rpx; color: #a06d78; font-size: 21rpx; text-decoration: underline; }
.field { margin-top: 28rpx; min-width: 0; }
.field-label { display: block; margin-bottom: 14rpx; color: #6d6367; font-size: 24rpx; }
.required { color: #ee5e80; }
.field-hint { margin-left: 10rpx; color: #aaa0a4; font-size: 21rpx; font-weight: 400; }
.input, .textarea { width: 100%; box-sizing: border-box; border: 2rpx solid #eee2e2; border-radius: 18rpx; background: #fffdfd; color: #494145; font-size: 24rpx; }
.input { height: 78rpx; padding: 0 20rpx; }
.picker { display: flex; align-items: center; color: #81777b; }
.textarea { height: 220rpx; padding: 20rpx; line-height: 1.6; }
.textarea.short { height: 150rpx; }
.choice-grid { display: grid; gap: 12rpx; }
.choice-grid.five { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.choice { min-width: 0; height: 116rpx; border: 2rpx solid #eee4e4; border-radius: 18rpx; background: #fffdfd; color: #655c60; display: flex; flex-direction: column; gap: 12rpx; align-items: center; justify-content: center; font-size: 22rpx; }
.choice-icon { color: #93898d; font-size: 25rpx; }
.choice.selected, .pill.selected { color: #ed5d80; border-color: #f2829d; background: #fff3f5; }
.choice.selected .choice-icon { color: #ed5d80; }
.choice-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.pill { min-width: 128rpx; height: 62rpx; padding: 0 20rpx; border: 2rpx solid #eee3e4; border-radius: 32rpx; background: #fffdfd; color: #655c60; display: flex; align-items: center; justify-content: center; font-size: 23rpx; }
.color-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 22rpx 10rpx; }
.color-choice { min-width: 0; color: #6e6468; display: flex; flex-direction: column; align-items: center; gap: 9rpx; font-size: 20rpx; }
.swatch { width: 48rpx; height: 48rpx; box-sizing: border-box; border: 2rpx solid #e2dada; border-radius: 50%; }
.rainbow { background: conic-gradient(#ef7d91, #f1c45f, #75b585, #78aee0, #b28bd5, #ef7d91); }
.color-selected .swatch { border: 5rpx solid #fff; box-shadow: 0 0 0 3rpx #ef6386; }
.color-selected { color: #e95b7e; }
.two-column { display: flex; gap: 18rpx; align-items: flex-start; }
.half { flex: 1; }
.compact { flex-wrap: nowrap; gap: 8rpx; }
.compact-pill { min-width: 72rpx; padding: 0 10rpx; }
.title-action { display: flex; justify-content: space-between; align-items: flex-start; }
.title-action .section-title { padding-top: 15rpx; }
.confirm-banner { background: #fff2f5; border-color: #f2c9d3; }
.confirm-title { display: block; color: #e75d7e; font-size: 27rpx; font-weight: 650; }
.confirm-copy { display: block; margin-top: 12rpx; color: #8c7d83; font-size: 22rpx; line-height: 1.6; }
.bottom-actions { display: flex; gap: 18rpx; margin-top: 28rpx; }
.action-button { flex: 1; height: 84rpx; font-size: 27rpx; }
button[disabled] { opacity: .6; }
