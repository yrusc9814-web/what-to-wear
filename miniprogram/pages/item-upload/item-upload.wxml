<view class="page">
  <view class="steps">
    <view class="step {{step > 1 ? 'done' : ''}} {{step === 1 ? 'active' : ''}}"><text class="step-number">1</text><text>上传图片</text></view>
    <view class="step-line {{step >= 2 ? 'active-line' : ''}}"></view>
    <view class="step {{step > 2 ? 'done' : ''}} {{step === 2 ? 'active' : ''}}"><text class="step-number">2</text><text>填写信息</text></view>
    <view class="step-line {{step >= 3 ? 'active-line' : ''}}"></view>
    <view class="step {{step === 3 ? 'active' : ''}}"><text class="step-number">3</text><text>确认保存</text></view>
  </view>

  <block wx:if="{{step === 1}}">
    <view class="upload-panel {{localImagePath ? 'has-image' : ''}}">
      <view class="upload-preview" wx:if="{{localImagePath}}">
        <image src="{{localImagePath}}" mode="aspectFit" />
      </view>
      <block wx:else>
        <view class="upload-icon"><text class="hanger-icon">♡</text></view>
        <text class="upload-title">上传或拍摄单品图片</text>
        <text class="upload-help">支持 JPG / PNG / WebP 格式，建议主体清晰、背景简洁</text>
      </block>
      <view class="upload-actions">
        <button class="primary small-button" bindtap="chooseCamera">◉ 拍照</button>
        <button class="soft small-button" bindtap="chooseAlbum">▣ 从相册选择</button>
      </view>
    </view>

    <view class="tip-block">
      <text class="tip-title">上传提示</text>
      <text class="section-copy">图片将保存为单品主图，上传后可手动填写名称、分类、季节、风格等属性。</text>
      <view class="tips">
        <text>✓ 保持图片清晰、光线充足</text>
        <text>✓ 单品主体完整，尽量避免裁切</text>
        <text>✓ 纯色或干净背景效果更好</text>
        <text>✓ 每件单品保存 1 张主图</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="recognition-card">
      <image class="recognition-image" src="{{imageUrl || localImagePath}}" mode="aspectFit" />
      <view class="recognition-status">
        <text wx:if="{{uploadState === 'uploading'}}" class="status-title">正在上传图片…</text>
        <text wx:elif="{{uploadState === 'success'}}" class="status-title success">✓ 图片已上传</text>
        <text wx:elif="{{uploadState === 'error'}}" class="status-title warning">图片上传失败</text>
        <text wx:else class="status-title">等待上传</text>
        <text class="status-copy">{{uploadState === 'success' ? '请填写单品信息，确认后保存' : '可直接手动填写，不影响保存'}}</text>
        <button wx:if="{{uploadState === 'error'}}" class="mini-button" bindtap="retryUpload">重试上传</button>
      </view>
    </view>

    <view class="form-card">
      <text class="section-title">基础信息（必填）</text>
      <view class="field">
        <text class="field-label">单品名称 <text class="required">*</text></text>
        <input class="input" maxlength="20" placeholder="请填写单品名称" value="{{form.name}}" data-field="name" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="field-label">分类 <text class="required">*</text></text>
        <view class="choice-grid five">
          <button wx:for="{{categoryOptions}}" wx:key="value" class="choice {{form.category === item.value ? 'selected' : ''}}" data-field="category" data-value="{{item.value}}" bindtap="onSingleSelect"><text class="choice-icon">{{item.icon}}</text><text>{{item.label}}</text></button>
        </view>
      </view>
      <view class="field">
        <text class="field-label">适用季节 <text class="required">*</text><text class="field-hint">可多选</text></text>
        <view class="choice-row">
          <button wx:for="{{seasonOptions}}" wx:key="value" class="pill {{selectedSeasons[item.value] ? 'selected' : ''}}" data-field="seasons" data-value="{{item.value}}" bindtap="onMultiSelect">{{item.label}}</button>
        </view>
      </view>
      <view class="field">
        <text class="field-label">风格 <text class="required">*</text><text class="field-hint">可多选</text></text>
        <view class="choice-row">
          <button wx:for="{{styleOptions}}" wx:key="value" class="pill {{selectedStyles[item.value] ? 'selected' : ''}}" data-field="styles" data-value="{{item.value}}" bindtap="onMultiSelect">{{item.label}}</button>
        </view>
      </view>
    </view>

    <view class="form-card">
      <text class="section-title">单品属性（选填）</text>
      <view class="field">
        <text class="field-label">主颜色 <text class="field-hint">单选</text></text>
        <view class="color-row">
          <button wx:for="{{colorOptions}}" wx:key="value" class="color-choice {{form.primaryColor === item.value ? 'color-selected' : ''}}" data-field="primaryColor" data-value="{{item.value}}" bindtap="onSingleSelect">
            <view class="swatch {{item.value === 'multicolor' ? 'rainbow' : ''}}" style="{{item.value === 'multicolor' ? '' : 'background:' + item.swatch}}"></view>
            <text>{{item.label}}</text>
          </button>
        </view>
      </view>
      <view class="two-column">
        <view class="field half">
          <text class="field-label">厚度</text>
          <view class="choice-row compact">
            <button wx:for="{{thicknessOptions}}" wx:key="value" class="pill compact-pill {{form.thickness === item.value ? 'selected' : ''}}" data-field="thickness" data-value="{{item.value}}" bindtap="onSingleSelect">{{item.label}}</button>
          </view>
        </view>
        <view class="field half">
          <text class="field-label">尺码</text>
          <input class="input" maxlength="20" placeholder="例如 M / 165/88A" value="{{form.size}}" data-field="size" bindinput="onInput" />
        </view>
      </view>
    </view>

    <view class="form-card">
      <text class="section-title">购买信息（选填）</text>
      <text class="safe-note">购买信息不会被图片内容生成，请手动填写</text>
      <view class="two-column">
        <view class="field half"><text class="field-label">购买价格（元）</text><input class="input" type="digit" maxlength="10" placeholder="0.00" value="{{form.purchasePrice}}" data-field="purchasePrice" bindinput="onInput" /></view>
        <view class="field half"><text class="field-label">购买日期</text><picker mode="date" end="{{today}}" value="{{form.purchaseDate}}" bindchange="onDateChange"><view class="input picker">{{form.purchaseDate || '请选择'}}</view></picker></view>
      </view>
      <view class="field"><text class="field-label">购买渠道</text><input class="input" maxlength="30" placeholder="例如淘宝、线下门店" value="{{form.purchaseChannel}}" data-field="purchaseChannel" bindinput="onInput" /></view>
    </view>

    <view class="form-card">
      <view class="title-action"><text class="section-title">✦ 单品介绍</text></view>
      <textarea class="textarea" maxlength="300" placeholder="可手动填写单品的文字介绍" value="{{form.aiDescription}}" data-field="aiDescription" bindinput="onInput" />
    </view>

    <view class="form-card">
      <text class="section-title">我的备注（选填）</text>
      <textarea class="textarea short" maxlength="200" placeholder="记录搭配提醒、洗护建议等…" value="{{form.note}}" data-field="note" bindinput="onInput" />
    </view>

    <view wx:if="{{step === 3}}" class="confirm-banner">
      <text class="confirm-title">信息已填写完成</text>
      <text class="confirm-copy">请再检查一遍，保存后会同步到衣橱和穿搭单品列表。</text>
    </view>

    <view class="bottom-actions">
      <button wx:if="{{step === 3}}" class="soft action-button" bindtap="backToEdit">返回修改</button>
      <button wx:else class="soft action-button" bindtap="cancel">取消</button>
      <button wx:if="{{step === 2}}" class="primary action-button" bindtap="goToConfirm">下一步：确认</button>
      <button wx:else class="primary action-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveItem">确认保存</button>
    </view>
  </block>
</view>
