.wardrobe-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.header-title {
  display: block;
  margin: 0;
}

.header-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8c7f7a;
  font-size: 25rpx;
}

.add-button {
  width: 150rpx;
  margin: 0;
  font-size: 26rpx;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.tab {
  height: 68rpx;
  border-radius: 14rpx;
  background: #f3e8e3;
  color: #7b6661;
  font-size: 25rpx;
  line-height: 68rpx;
}

.tab.active {
  background: #2f2624;
  color: #ffffff;
}

.form-card {
  margin-bottom: 24rpx;
}

.form-title {
  display: block;
  margin-bottom: 12rpx;
  color: #2f2624;
  font-size: 30rpx;
  font-weight: 700;
}

.form-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 76rpx;
  border-bottom: 1rpx solid #f2e7e2;
}

.label {
  width: 92rpx;
  color: #7b6661;
  font-size: 26rpx;
}

.input,
.picker-value {
  flex: 1;
  color: #2f2624;
  font-size: 28rpx;
}

.picker-value {
  min-width: 420rpx;
}

.temp-inputs {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.temp-input {
  width: 120rpx;
  flex: none;
  text-align: center;
}

.temp-separator,
.temp-unit {
  color: #8c7f7a;
  font-size: 25rpx;
}

.image-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 310rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border: 2rpx dashed #e3d2cc;
  border-radius: 14rpx;
  background: #fffaf7;
}

.preview {
  width: 100%;
  height: 100%;
}

.image-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.image-empty-title {
  color: #6f5550;
  font-size: 28rpx;
  font-weight: 700;
}

.image-empty-subtitle {
  color: #a59590;
  font-size: 24rpx;
}

.form-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.analyze-button {
  margin-top: 18rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.item-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(79, 52, 45, 0.08);
}

.item-image {
  width: 100%;
  height: 260rpx;
  background: #f3e8e3;
}

.item-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 24rpx;
  color: #8c7f7a;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.item-info {
  padding: 18rpx 18rpx 8rpx;
}

.item-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #2f2624;
  font-size: 28rpx;
  font-weight: 700;
}

.item-meta {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #8c7f7a;
  font-size: 23rpx;
}

.item-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin: 0 18rpx 18rpx;
}

.edit-button,
.delete-button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.edit-button {
  background: #f3e8e3;
  color: #6f5550;
}

.delete-button {
  background: #fff0ee;
  color: #b45f6b;
}
