.hero {
  padding: 34rpx 0 22rpx;
}

.eyebrow {
  display: block;
  color: #b45f6b;
  font-size: 22rpx;
  letter-spacing: 0;
}

.title {
  display: block;
  margin-top: 10rpx;
  font-size: 54rpx;
  font-weight: 800;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #8c7f7a;
  font-size: 26rpx;
}

.weather-card {
  background: linear-gradient(135deg, #4f5978, #86586d);
  color: #ffffff;
}

.weather-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.weather-temp {
  font-size: 70rpx;
  font-weight: 800;
}

.weather-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.weather-cond {
  font-size: 30rpx;
  font-weight: 700;
}

.weather-city,
.weather-tip {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.weather-tip {
  display: block;
  margin-top: 20rpx;
  line-height: 1.55;
}

.weather-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.forecast-row {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
  overflow-x: auto;
}

.forecast-chip {
  flex: 0 0 128rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-height: 88rpx;
  margin: 0;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 1.35;
}

.forecast-chip.active {
  background: rgba(255, 255, 255, 0.94);
  color: #5b4654;
}

.action-button {
  font-size: 26rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  padding: 24rpx;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.record-date {
  color: #2f2624;
  font-size: 30rpx;
  font-weight: 700;
}

.record-delete {
  width: 118rpx;
  margin: 0;
  border-radius: 12rpx;
  background: #fff0ee;
  color: #b45f6b;
  font-size: 24rpx;
}

.record-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.record-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f7eee9;
  color: #a59590;
  font-size: 24rpx;
}

.record-cell image {
  width: 100%;
  height: 100%;
}

.record-note {
  display: block;
  margin-top: 16rpx;
  color: #8c7f7a;
  font-size: 25rpx;
  line-height: 1.55;
}

.danger-button {
  border-radius: 14rpx;
  background: #fff0ee;
  color: #b45f6b;
  font-weight: 600;
}
