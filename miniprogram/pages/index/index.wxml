<view class="page">
  <view class="hero">
    <text class="eyebrow">TODAY'S LOOK</text>
    <text class="title">今天穿什么</text>
    <text class="subtitle">{{todayLabel}}</text>
  </view>

  <view class="section-title">今日天气</view>
  <view class="card weather-card">
    <view class="weather-main">
      <text class="weather-temp">{{weather.tempText}}</text>
      <view class="weather-meta">
        <text class="weather-cond">{{weather.weatherText}}</text>
        <text class="weather-city">{{weather.cityText}}</text>
      </view>
    </view>
    <text class="weather-tip">{{weather.suggestion}}</text>
    <view wx:if="{{weather.forecast.length}}" class="forecast-row">
      <button wx:for="{{weather.forecast}}" wx:key="date" class="forecast-chip {{selectedForecastIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectForecast">
        <text>{{item.label}}</text>
        <text>{{item.tempMin}}-{{item.tempMax}}℃</text>
      </button>
    </view>
    <view class="weather-actions">
      <button class="secondary-button action-button" bindtap="chooseManualCity">手动选城市</button>
      <button class="primary-button action-button" loading="{{weather.loading}}" bindtap="refreshByLocation">自动定位</button>
    </view>
  </view>

  <view class="section-title">今日推荐</view>
  <view class="card empty-card">
    <text class="empty-title">{{selectedForecastIndex === 0 ? '生成今天的搭配' : '未来日期仅展示天气'}}</text>
    <text class="empty-subtitle">{{selectedForecastIndex === 0 ? '推荐会结合天气、衣橱和风格偏好生成。' : '第一版仅支持今日推荐，切回今天后可生成搭配。'}}</text>
    <view class="quick-actions">
      <button class="secondary-button" bindtap="goWardrobe">整理衣橱</button>
      <button class="primary-button" bindtap="goRecommendation">{{selectedForecastIndex === 0 ? '去推荐' : '切回今天'}}</button>
    </view>
  </view>

  <view class="section-title">穿搭记录</view>
  <view wx:if="{{loadingRecords}}" class="card empty-card">
    <text class="empty-title">正在同步记录</text>
    <text class="empty-subtitle">稍等一下，正在读取你的穿搭日记。</text>
  </view>

  <view wx:elif="{{records.length}}" class="record-list">
    <view wx:for="{{records}}" wx:key="id" class="card record-card">
      <view class="record-header">
        <text class="record-date">{{item.date}}</text>
        <button class="record-delete" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
      </view>
      <view class="record-grid">
        <view class="record-cell">
          <image wx:if="{{item.top && item.top.imageUrl}}" src="{{item.top.imageUrl}}" mode="aspectFill" />
          <text wx:elif="{{item.top}}">{{item.top.name}}</text>
          <text wx:else>上衣</text>
        </view>
        <view class="record-cell">
          <image wx:if="{{item.bottom && item.bottom.imageUrl}}" src="{{item.bottom.imageUrl}}" mode="aspectFill" />
          <text wx:elif="{{item.bottom}}">{{item.bottom.name}}</text>
          <text wx:else>下装</text>
        </view>
        <view class="record-cell">
          <image wx:if="{{item.shoes && item.shoes.imageUrl}}" src="{{item.shoes.imageUrl}}" mode="aspectFill" />
          <text wx:elif="{{item.shoes}}">{{item.shoes.name}}</text>
          <text wx:else>鞋子</text>
        </view>
        <view class="record-cell">
          <image wx:if="{{item.accessory && item.accessory.imageUrl}}" src="{{item.accessory.imageUrl}}" mode="aspectFill" />
          <text wx:elif="{{item.accessory}}">{{item.accessory.name}}</text>
          <text wx:else>配饰</text>
        </view>
      </view>
      <text wx:if="{{item.note}}" class="record-note">{{item.note}}</text>
    </view>
  </view>

  <view wx:else class="card empty-card">
    <text class="empty-title">还没有记录</text>
    <text class="empty-subtitle">从推荐页选择一套搭配，就能保存到这里。</text>
  </view>

  <view class="section-title">数据与隐私</view>
  <view class="card empty-card">
    <text class="empty-title">清除我的数据</text>
    <text class="empty-subtitle">会软删除云端衣橱和穿搭记录，并清空本机缓存。</text>
    <button class="danger-button" bindtap="clearMyData">清除全部数据</button>
  </view>
</view>
