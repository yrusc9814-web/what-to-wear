.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.summary text {
  border-radius: 14rpx;
  background: #f3e8e3;
  color: #6f5550;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
}

.generate-button {
  margin-bottom: 22rpx;
}

.rule-context {
  margin: -4rpx 0 18rpx;
  color: #8c7f7a;
  font-size: 24rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-card {
  padding: 24rpx;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.result-index {
  color: #2f2624;
  font-size: 30rpx;
  font-weight: 700;
}

.result-tag {
  border-radius: 999rpx;
  background: #fff0ee;
  color: #b45f6b;
  font-size: 23rpx;
  padding: 8rpx 16rpx;
}

.preview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.preview-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f7eee9;
  color: #a59590;
  font-size: 24rpx;
}

.preview-cell image {
  width: 100%;
  height: 100%;
}

.accessory {
  background: #f0edf8;
}

.reason {
  display: block;
  margin-top: 18rpx;
  color: #8c7f7a;
  font-size: 26rpx;
  line-height: 1.55;
}

.save-button {
  margin-top: 18rpx;
}
