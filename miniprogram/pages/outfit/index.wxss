page {
  min-height: 100%;
  background: #fff9f8;
  color: #432b2d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 8% 2%, rgba(255, 223, 228, 0.52), transparent 24%), #fff9f8;
}

.safe-top {
  height: calc(env(safe-area-inset-top) + 24rpx);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 10rpx 28rpx;
}

.brand {
  color: #f64f78;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.sparkle {
  color: #fa86a1;
  font-size: 34rpx;
}

.saved-link {
  display: flex;
  min-height: 66rpx;
  align-items: center;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #ffcbd6;
  border-radius: 36rpx;
  color: #f04e76;
  font-size: 24rpx;
  line-height: 66rpx;
  background: #fff0f3;
}

.saved-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
}

.preview-card {
  position: relative;
  min-height: 550rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 2rpx solid #ffcbd3;
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(255, 243, 244, 0.82));
  box-shadow: 0 18rpx 40rpx rgba(190, 105, 121, 0.08);
  box-sizing: border-box;
}

.preview-heading {
  position: relative;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.preview-title {
  color: #54383a;
  font-size: 28rpx;
  font-weight: 600;
}

.shuffle-button {
  display: flex;
  min-height: 58rpx;
  align-items: center;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid #ffd6dc;
  border-radius: 32rpx;
  color: #ed5276;
  font-size: 25rpx;
  line-height: 58rpx;
  background: rgba(255, 255, 255, 0.75);
}

.shuffle-button text {
  margin-left: 10rpx;
}

.composition {
  position: relative;
  width: 100%;
  height: 410rpx;
  margin-top: 2rpx;
}

.composition::after {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 330rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(202, 145, 151, 0.1);
  content: '';
  transform: translateX(-50%);
  filter: blur(12rpx);
}

.composition-empty {
  position: absolute;
  inset: 50rpx 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #b59398;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.hanger {
  margin-bottom: 14rpx;
  color: #ef9caf;
  font-size: 80rpx;
  transform: rotate(180deg);
}

.layer {
  position: absolute;
  display: block;
  z-index: 2;
}

.layer-hat {
  top: 2rpx;
  left: 50%;
  z-index: 8;
  width: 130rpx;
  height: 92rpx;
  transform: translateX(-50%);
}

.layer-top {
  top: 74rpx;
  left: 50%;
  z-index: 7;
  width: 230rpx;
  height: 174rpx;
  transform: translateX(-50%);
}

.layer-bottom {
  top: 210rpx;
  left: 50%;
  z-index: 5;
  width: 240rpx;
  height: 156rpx;
  transform: translateX(-50%);
}

.layer-shoes {
  top: 332rpx;
  left: 50%;
  z-index: 6;
  width: 198rpx;
  height: 76rpx;
  transform: translateX(-45%);
}

.layer-bag {
  top: 182rpx;
  left: calc(50% + 74rpx);
  z-index: 10;
  width: 146rpx;
  height: 142rpx;
}

.layer-missing {
  opacity: 0.54;
  filter: grayscale(1);
}

.preview-caption {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.style-name {
  color: #ef5277;
  font-size: 24rpx;
}

.scene-name {
  margin-top: 8rpx;
  color: #685759;
  font-size: 19rpx;
}

.deleted-warning {
  position: absolute;
  left: 22rpx;
  right: 200rpx;
  bottom: 18rpx;
  z-index: 21;
  color: #b45a69;
  font-size: 20rpx;
  line-height: 1.4;
}

.selector-list {
  padding-top: 12rpx;
}

.selector-row {
  display: flex;
  min-height: 150rpx;
  align-items: center;
  padding: 12rpx 0;
}

.category-label {
  display: flex;
  width: 108rpx;
  flex: 0 0 108rpx;
  align-items: center;
  flex-wrap: wrap;
}

.category-icon {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  border-radius: 10rpx;
  color: #fff;
  font-size: 17rpx;
  background: #f45a7d;
}

.category-name {
  color: #4e3739;
  font-size: 25rpx;
}

.optional {
  width: 100%;
  margin: 6rpx 0 0 42rpx;
  color: #b3999e;
  font-size: 17rpx;
}

.item-scroll {
  width: calc(100vw - 156rpx);
  white-space: nowrap;
}

.item-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 24rpx 4rpx 2rpx;
}

.item-card {
  position: relative;
  display: inline-flex;
  width: 124rpx;
  height: 136rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 6rpx 6rpx 8rpx;
  overflow: hidden;
  border: 2rpx solid #f0dcdd;
  border-radius: 20rpx;
  color: #675456;
  line-height: 1;
  background: rgba(255, 255, 255, 0.78);
}

.item-card-active {
  border-color: #ff537d;
  background: #fff7f8;
  box-shadow: 0 8rpx 18rpx rgba(244, 83, 124, 0.1);
}

.item-image,
.item-image-empty {
  width: 102rpx;
  height: 95rpx;
}

.item-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  color: #d18f9c;
  font-size: 34rpx;
  background: #fff0f2;
}

.item-name {
  width: 108rpx;
  overflow: hidden;
  margin-top: 5rpx;
  font-size: 18rpx;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.check-mark {
  position: absolute;
  right: 4rpx;
  bottom: 24rpx;
  display: flex;
  width: 28rpx;
  height: 28rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #fff;
  border-radius: 50%;
  color: #fff;
  font-size: 18rpx;
  background: #ff4f78;
}

.none-card {
  color: #a48e91;
}

.none-symbol {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  border: 2rpx dashed #e4cdd0;
  border-radius: 50%;
  font-size: 30rpx;
}

.category-empty {
  display: flex;
  min-height: 100rpx;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  border: 2rpx dashed #efd9dc;
  border-radius: 20rpx;
  color: #9a8588;
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.5);
}

.category-empty button {
  min-height: 58rpx;
  margin: 0;
  padding: 0 16rpx;
  color: #ed5276;
  font-size: 21rpx;
  line-height: 58rpx;
  background: transparent;
}

.save-button {
  display: flex;
  width: 100%;
  min-height: 90rpx;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 0;
  border-radius: 46rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 90rpx;
  background: linear-gradient(110deg, #ff7d98, #f74e79);
  box-shadow: 0 14rpx 28rpx rgba(237, 79, 118, 0.2);
}

.save-arrow {
  margin-left: 16rpx;
  font-size: 34rpx;
}

.bottom-space {
  height: calc(env(safe-area-inset-bottom) + 36rpx);
}

.state-card {
  display: flex;
  min-height: 440rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  border: 2rpx solid #f3d7dc;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.78);
}

.state-spinner {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 28rpx;
  border: 5rpx solid #f8d6de;
  border-top-color: #ef6382;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-symbol {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border-radius: 50%;
  color: #e7667e;
  font-size: 40rpx;
  background: #fff0f2;
}

.state-title {
  font-size: 29rpx;
  font-weight: 600;
}

.state-copy {
  margin-top: 14rpx;
  color: #978487;
  font-size: 23rpx;
  text-align: center;
}

.secondary-button {
  min-height: 68rpx;
  margin: 28rpx 0 0;
  padding: 0 34rpx;
  border: 2rpx solid #f5bdca;
  border-radius: 36rpx;
  color: #e65375;
  font-size: 24rpx;
  line-height: 68rpx;
  background: #fff5f6;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(69, 43, 47, 0.32);
}

.save-sheet {
  width: 100%;
  padding: 14rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 40rpx 40rpx 0 0;
  background: #fffaf9;
  box-shadow: 0 -18rpx 50rpx rgba(91, 51, 58, 0.12);
  box-sizing: border-box;
}

.sheet-handle {
  width: 74rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 4rpx;
  background: #ead5d8;
}

.sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-title,
.sheet-subtitle {
  display: block;
}

.sheet-title {
  color: #452d30;
  font-size: 34rpx;
  font-weight: 650;
}

.sheet-subtitle {
  margin-top: 9rpx;
  color: #9b888b;
  font-size: 21rpx;
}

.close-button {
  width: 64rpx;
  height: 64rpx;
  min-height: 0;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: #aa9195;
  font-size: 42rpx;
  line-height: 58rpx;
  background: #f8eeef;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  color: #5b4346;
  font-size: 24rpx;
  font-weight: 600;
}

.field-label text {
  color: #ee5679;
}

.title-input {
  height: 82rpx;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border: 2rpx solid #efd9dc;
  border-radius: 22rpx;
  color: #473033;
  font-size: 26rpx;
  background: #fff;
  box-sizing: border-box;
}

.chip-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.choice-chip {
  min-width: 104rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #eddcdf;
  border-radius: 34rpx;
  color: #7b686b;
  font-size: 23rpx;
  line-height: 64rpx;
  background: #fff;
}

.choice-chip-active {
  border-color: #ff708f;
  color: #ee4d72;
  background: #fff0f3;
}

.sheet-actions,
.edit-actions {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.edit-actions {
  grid-template-columns: .72fr 1fr 1fr;
}

.sheet-primary,
.sheet-secondary,
.sheet-cancel {
  min-height: 82rpx;
  margin: 0;
  border-radius: 42rpx;
  font-size: 25rpx;
  line-height: 82rpx;
}

.sheet-primary {
  color: #fff;
  background: linear-gradient(110deg, #ff7995, #f44f77);
}

.sheet-secondary {
  border: 2rpx solid #f0ccd3;
  color: #d95775;
  background: #fff5f6;
}

.sheet-cancel {
  color: #9b898d;
  background: #f8f1f2;
}
