<view class="page">
  <view class="safe-top"></view>

  <view class="header">
    <view class="brand">试穿 <text class="sparkle">✦</text></view>
  </view>

  <view class="mode-switch">
    <view class="mode-segment mode-active" data-mode="dressing" bindtap="onModeSwitch">试衣间</view>
    <view class="mode-segment" data-mode="saved" bindtap="onModeSwitch">我的搭配</view>
  </view>

  <view wx:if="{{state === 'loading'}}" class="state-card">
    <view class="state-spinner"></view>
    <text class="state-title">正在同步你的衣橱</text>
    <text class="state-copy">稍后就可以开始搭配</text>
  </view>

  <view wx:elif="{{state === 'error'}}" class="state-card">
    <text class="state-symbol">!</text>
    <text class="state-title">暂时无法加载穿搭</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="secondary-button" bindtap="loadEditor">重试</button>
  </view>

  <block wx:else>
    <!-- 左右两栏 47.5:52.5：左栏「已选衣物」326rpx + 间距 16rpx，右栏画板 360rpx；点阵画布吃满右栏剩余高度 -->
    <view class="workspace">
      <view class="slot-panel">
        <view class="panel-title">已选衣物</view>
        <view wx:if="{{isAllSlotsEmpty}}" class="slot-empty-hint">从下方选衣区挑选单品</view>
        <view class="slot-list">
          <!-- 槽卡分 filled / empty 两态：filled 显示缩略图+名称+三枚图层操作（↑↓× 绑定当前槽位）；empty 仅显示槽名占位 -->
          <view wx:for="{{slotList}}" wx:key="slot" class="slot-card {{item.filled ? 'slot-card-filled' : ''}} {{selectedSlot === item.slot ? 'slot-card-selected' : ''}}" data-slot="{{item.slot}}" bindtap="onSlotCardTap">
            <block wx:if="{{item.filled}}">
              <view class="slot-main">
                <image wx:if="{{item.imageUrl}}" class="slot-thumb" src="{{item.imageUrl}}" mode="aspectFit"></image>
                <view wx:else class="slot-thumb slot-thumb-empty">{{item.initial}}</view>
                <view class="slot-info">
                  <text class="slot-tag">{{item.label}}</text>
                  <text class="slot-name">{{item.name}}</text>
                </view>
                <view wx:if="{{selectedSlot === item.slot}}" class="slot-check">✓</view>
              </view>
              <view class="slot-actions">
                <view class="slot-action {{selectedSlot === item.slot ? '' : 'slot-action-disabled'}}" data-slot="{{item.slot}}" catchtap="onLayerUp" aria-label="上移一层">↑</view>
                <view class="slot-action {{selectedSlot === item.slot ? '' : 'slot-action-disabled'}}" data-slot="{{item.slot}}" catchtap="onLayerDown" aria-label="下移一层">↓</view>
                <view class="slot-action slot-action-danger" data-category="{{item.slot}}" data-id="" catchtap="onSelectItem" aria-label="移除该单品">×</view>
              </view>
            </block>
            <text wx:else class="slot-empty-label">{{item.label}}</text>
          </view>
        </view>
        <view class="reset-canvas {{isAllSlotsEmpty ? 'reset-canvas-disabled' : ''}}" bindtap="onResetAll">重置画布</view>
      </view>

      <view class="canvas-panel">
        <view class="canvas-head">
          <text class="canvas-title">试衣搭配画板</text>
          <view class="shuffle-button" bindtap="onShuffle">↻ <text>换一套</text></view>
        </view>

        <view class="composition-wrap">
          <view class="composition" bindtap="onCanvasTap">
            <view wx:if="{{isAllSlotsEmpty}}" class="composition-empty">
              <view class="hanger">⌒</view>
              <text>从下方选衣区挑选衣物，拖拽或缩放调整</text>
            </view>
            <image wx:if="{{previewSlots.hat && previewSlots.hat.imageUrl}}" class="layer layer-hat {{previewSlots.hat.missing ? 'layer-missing' : ''}} {{renderLayers.hat.selected ? 'layer-selected' : ''}}" style="left: {{renderLayers.hat.x}}rpx; top: {{renderLayers.hat.y}}rpx; width: {{renderLayers.hat.width}}rpx; height: {{renderLayers.hat.height}}rpx; z-index: {{renderLayers.hat.zIndex}};" src="{{previewSlots.hat.imageUrl}}" mode="aspectFit" data-slot="hat" catchtouchstart="onLayerTouchStart" catchtouchmove="onLayerTouchMove" catchtouchend="onLayerTouchEnd" catchtouchcancel="onLayerTouchEnd" catchtap="stopPropagation"></image>
            <image wx:if="{{previewSlots.top && previewSlots.top.imageUrl}}" class="layer layer-top {{previewSlots.top.missing ? 'layer-missing' : ''}} {{renderLayers.top.selected ? 'layer-selected' : ''}}" style="left: {{renderLayers.top.x}}rpx; top: {{renderLayers.top.y}}rpx; width: {{renderLayers.top.width}}rpx; height: {{renderLayers.top.height}}rpx; z-index: {{renderLayers.top.zIndex}};" src="{{previewSlots.top.imageUrl}}" mode="aspectFit" data-slot="top" catchtouchstart="onLayerTouchStart" catchtouchmove="onLayerTouchMove" catchtouchend="onLayerTouchEnd" catchtouchcancel="onLayerTouchEnd" catchtap="stopPropagation"></image>
            <image wx:if="{{previewSlots.bottom && previewSlots.bottom.imageUrl}}" class="layer layer-bottom {{previewSlots.bottom.missing ? 'layer-missing' : ''}} {{renderLayers.bottom.selected ? 'layer-selected' : ''}}" style="left: {{renderLayers.bottom.x}}rpx; top: {{renderLayers.bottom.y}}rpx; width: {{renderLayers.bottom.width}}rpx; height: {{renderLayers.bottom.height}}rpx; z-index: {{renderLayers.bottom.zIndex}};" src="{{previewSlots.bottom.imageUrl}}" mode="aspectFit" data-slot="bottom" catchtouchstart="onLayerTouchStart" catchtouchmove="onLayerTouchMove" catchtouchend="onLayerTouchEnd" catchtouchcancel="onLayerTouchEnd" catchtap="stopPropagation"></image>
            <image wx:if="{{previewSlots.shoes && previewSlots.shoes.imageUrl}}" class="layer layer-shoes {{previewSlots.shoes.missing ? 'layer-missing' : ''}} {{renderLayers.shoes.selected ? 'layer-selected' : ''}}" style="left: {{renderLayers.shoes.x}}rpx; top: {{renderLayers.shoes.y}}rpx; width: {{renderLayers.shoes.width}}rpx; height: {{renderLayers.shoes.height}}rpx; z-index: {{renderLayers.shoes.zIndex}};" src="{{previewSlots.shoes.imageUrl}}" mode="aspectFit" data-slot="shoes" catchtouchstart="onLayerTouchStart" catchtouchmove="onLayerTouchMove" catchtouchend="onLayerTouchEnd" catchtouchcancel="onLayerTouchEnd" catchtap="stopPropagation"></image>
            <image wx:if="{{previewSlots.bag && previewSlots.bag.imageUrl}}" class="layer layer-bag {{previewSlots.bag.missing ? 'layer-missing' : ''}} {{renderLayers.bag.selected ? 'layer-selected' : ''}}" style="left: {{renderLayers.bag.x}}rpx; top: {{renderLayers.bag.y}}rpx; width: {{renderLayers.bag.width}}rpx; height: {{renderLayers.bag.height}}rpx; z-index: {{renderLayers.bag.zIndex}};" src="{{previewSlots.bag.imageUrl}}" mode="aspectFit" data-slot="bag" catchtouchstart="onLayerTouchStart" catchtouchmove="onLayerTouchMove" catchtouchend="onLayerTouchEnd" catchtouchcancel="onLayerTouchEnd" catchtap="stopPropagation"></image>
          </view>
          <view class="canvas-hint">{{selectedHint}}</view>
        </view>
      </view>
    </view>

    <button class="save-button" bindtap="onSaveTap">
      <text>保存为我的推荐搭配</text>
    </button>

    <view class="preview-caption">
      <text class="style-name">{{previewStyle}}</text>
      <text class="caption-sep">·</text>
      <text class="scene-name">{{previewScene}}</text>
    </view>

    <view wx:if="{{missingSlotLabels.length}}" class="deleted-warning">
      {{missingSlotText}}中的单品已从衣橱删除，请重新选择后保存
    </view>

    <view class="pick-card">
      <view class="pick-header">
        <text class="pick-title">可选入库衣物</text>
        <text class="pick-count">已选 {{selectedCount}}/5</text>
      </view>

      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-track">
          <view wx:for="{{filterOptions}}" wx:key="value" class="filter-chip {{activeFilter === item.value ? 'filter-chip-active' : ''}}" data-value="{{item.value}}" bindtap="onFilterTap">{{item.label}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{gridEmpty}}" class="category-empty">
        <text>该分类还没有单品</text>
        <button bindtap="goWardrobe">去衣橱上传</button>
      </view>

      <!-- 四宫格选衣卡：图片主体 + 一行名称 + 选中态，不含其他元数据 -->
      <view wx:else class="item-grid">
        <view wx:for="{{gridItems}}" wx:key="id" wx:for-item="piece" class="item-card {{piece.selected ? 'item-card-active' : ''}}" data-category="{{piece.category}}" data-id="{{piece.id}}" bindtap="onSelectItem">
          <view class="item-frame">
            <image wx:if="{{piece.imageUrl}}" class="item-image" src="{{piece.imageUrl}}" mode="aspectFit"></image>
            <view wx:else class="item-image item-image-empty">{{piece.initial}}</view>
            <view wx:if="{{piece.selected}}" class="check-mark">✓</view>
          </view>
          <text class="item-name">{{piece.name}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </block>

  <view wx:if="{{saveOpen}}" class="sheet-mask" bindtap="closeSaveSheet">
    <view class="save-sheet" catchtap="stopPropagation">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <view>
          <text class="sheet-title">{{draft.mode === 'edit' ? '保存编辑' : '保存搭配'}}</text>
          <text class="sheet-subtitle">记录这套搭配的名称与标签</text>
        </view>
        <button class="close-button" bindtap="closeSaveSheet">×</button>
      </view>

      <view class="field">
        <text class="field-label">搭配名称 <text>*</text></text>
        <input class="title-input" value="{{draft.title}}" maxlength="30" placeholder="例如：春日约会" bindinput="onTitleInput" />
      </view>

      <view class="field">
        <text class="field-label">季节 <text>*</text></text>
        <view class="chip-row">
          <button wx:for="{{seasonOptions}}" wx:key="value" class="choice-chip {{draft.season === item.value ? 'choice-chip-active' : ''}}" data-value="{{item.value}}" bindtap="onSeasonSelect">{{item.label}}</button>
        </view>
      </view>

      <view class="field">
        <text class="field-label">风格 <text>*</text></text>
        <view class="chip-row">
          <button wx:for="{{styleOptions}}" wx:key="value" class="choice-chip {{draft.style === item.value ? 'choice-chip-active' : ''}}" data-value="{{item.value}}" bindtap="onStyleSelect">{{item.label}}</button>
        </view>
      </view>

      <view wx:if="{{draft.mode === 'edit'}}" class="edit-actions">
        <button class="sheet-cancel" disabled="{{saving}}" bindtap="closeSaveSheet">取消</button>
        <button class="sheet-secondary" disabled="{{saving}}" bindtap="onSaveAsNew">另存为新搭配</button>
        <button class="sheet-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onUpdateSave">更新原搭配</button>
      </view>
      <view wx:else class="sheet-actions">
        <button class="sheet-secondary" disabled="{{saving}}" bindtap="closeSaveSheet">取消</button>
        <button class="sheet-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onCreateSave">保存搭配</button>
      </view>
    </view>
  </view>
</view>
